# Environment (development or production)
ENV=development

# Application Paths
BASE_DIR=/opt/kewr-panel
WWW_DIR=/var/lib/kewr-panel
LOG_DIR=/var/log/kewr-panel
CONFIG_DIR=/etc/kewr-panel
RUNTIME_DIR=/var/run/kewr-panel

# Development Paths (used when ENV=development)
DEV_BASE_DIR=./
DEV_WWW_DIR=./www
DEV_LOG_DIR=./logs
DEV_CONFIG_DIR=./config
DEV_RUNTIME_DIR=./run

# Logging
LOG_LEVEL=info

# Server Configuration
PORT=3000
HOST=127.0.0.1